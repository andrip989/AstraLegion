{
  "name": "astra-legion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype MOBA 3D berbasis web bertema superhero original (Three.js + Socket.IO, server authoritative)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/index.cjs",
    "start": "node dist/server/index.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "sim": "tsx server/src/simtest.ts"
  },
  "dependencies": {
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
